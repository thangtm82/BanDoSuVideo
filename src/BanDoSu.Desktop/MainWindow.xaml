<Window x:Class="BanDoSu.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Bản Đồ Sử Studio — Biên tập video" Height="860" Width="1420" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterScreen" Closing="OnWindowClosing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#182B3B" Padding="14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="20" FontWeight="Bold" Text="Bản Đồ Sử Studio" VerticalAlignment="Center"/>
                <TextBlock Foreground="#B5CBD8" FontSize="13" Margin="20,0,0,0" Text="Windows • Sử dụng engine bản đồ H2" VerticalAlignment="Center"/>
                <TextBlock x:Name="ProjectHeader" Foreground="#F2D19E" Margin="22,0,0,0" VerticalAlignment="Center" Text="Chưa chọn dự án"/>
            </StackPanel>
        </Border>
        <Grid DockPanel.Dock="Bottom" Height="190">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="7,4">
                <TextBlock Text="Nhật ký xử lý" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Hủy tác vụ đang chạy" Click="CancelClick" HorizontalAlignment="Right"/>
            </DockPanel>
            <TextBox Grid.Row="1" Name="LogOutput" FontFamily="Consolas" FontSize="12"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" AcceptsReturn="True"/>
        </Grid>
        <TabControl x:Name="MainTabs" Margin="8">
            <TabItem Header="Dự án">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="Bold" Text="Danh sách dự án" Margin="4"/>
                        <Button Content="Làm mới danh sách" Click="RefreshProjectsClick"/>
                        <ListBox Name="ProjectsList" Height="410" Margin="4" DisplayMemberPath="Title" SelectionChanged="ProjectsSelectionChanged"/>
                        <TextBlock Text="Chọn một dự án trong danh sách để tiếp tục." TextWrapping="Wrap" Margin="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Tạo dự án mới" FontSize="17" FontWeight="Bold" Margin="4"/>
                        <TextBlock Text="Tên thư mục dự án (chữ không dấu, số, dấu gạch nối)" Margin="4"/>
                        <TextBox Name="NewSlug" Text="hoa-lu-thang-long"/>
                        <TextBlock Text="Tiêu đề video" Margin="4"/>
                        <TextBox Name="NewTitle" Text="Hoa Lư - Thăng Long năm 1010"/>
                        <TextBlock Text="Loại dự án / Pack + phiên bản engine" Margin="4"/>
                        <ComboBox x:Name="NewPackCombo" DisplayMemberPath="DisplayName"
                                  SelectionChanged="NewPackChanged" Margin="4,0" MinHeight="27"/>
                        <WrapPanel Margin="4,6,0,4">
                            <TextBlock Text="Ngôn ngữ" VerticalAlignment="Center"/>
                            <TextBox x:Name="NewLangInput" Text="vi" Width="65" Margin="5,0,10,0"/>
                            <TextBlock Text="Style" VerticalAlignment="Center"/>
                            <TextBox x:Name="NewStyleInput" Text="flat" Width="90" Margin="5,0,0,0"/>
                        </WrapPanel>
                        <TextBlock x:Name="PackStatus" Margin="4" TextWrapping="Wrap"
                                   Text="Chưa phát hiện H2 Pack. Hãy nhập engine từ ZIP hoặc thư mục kit."/>
                        <WrapPanel>
                            <Button Content="Nhập ZIP H2 / Terrain" Click="ImportPackZipClick"/>
                            <Button Content="Nhập thư mục engine" Click="ImportPackFolderClick"/>
                            <Button Content="Quét các Pack" Click="RefreshPacksClick"/>
                        </WrapPanel>
                        <CheckBox Name="NewCaptions" Margin="8" Content="Bật phụ đề karaoke" IsChecked="True"/>
                        <Button Content="Tạo dự án" Click="CreateProjectClick" HorizontalAlignment="Left"/>
                        <Button Content="Mở thư mục dự án" Click="OpenProjectFolderClick" HorizontalAlignment="Left"/>
                        <Button Content="Nhập dự án H2 có sẵn (kể cả Terrain mẫu)" Click="ImportExistingProjectClick" HorizontalAlignment="Left"/>
                        <Button Content="Sao chép dự án cũ vào Workspace" Click="MigrateLegacyClick" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="SelectedEngineInfo" Margin="4,10,4,4"
                                   TextWrapping="Wrap" Text="Engine của dự án: chưa chọn"/>
                        <Button Content="Gắn dự án với engine đã chọn (cùng Pack)"
                                Click="BindProjectEngineClick" HorizontalAlignment="Left"/>
                        <TextBlock TextWrapping="Wrap" Margin="6,16,0,0" Text="Bản Portable tạo studio, Projects và Exports cạnh tệp EXE. Dự án cũ vẫn có thể sao chép sang Workspace."/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="AI Kịch bản">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="AI Kịch bản · kich-ban-bandosu" FontSize="18" FontWeight="Bold" Margin="4"/>
                        <TextBlock Text="Tạo kịch bản lịch sử, lời đọc chia đoạn, kế hoạch bản đồ và nội dung YouTube. Cần đọc và xác minh dữ kiện sử trước khi xuất bản. Không tự render từ file 03." Margin="4" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Chủ đề" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="AiTopicInput" Grid.Column="1" Text="Vì sao Lý Thái Tổ dời đô từ Hoa Lư về Thăng Long?" Margin="3"/>
                        <TextBlock Grid.Column="2" Text="Thời lượng" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="AiDurationInput" Grid.Column="3" SelectedIndex="0" Margin="3">
                            <ComboBoxItem Content="12 phút" Tag="12"/>
                            <ComboBoxItem Content="25 phút" Tag="25"/>
                        </ComboBox>
                        <TextBlock Grid.Column="4" Text="Nhà cung cấp" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="AiProviderInput" Grid.Column="5" SelectedIndex="0" SelectionChanged="AiProviderChanged" Margin="3">
                            <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                            <ComboBoxItem Content="Gemini" Tag="Gemini"/>
                            <ComboBoxItem Content="Custom (OpenAI Compatible)" Tag="Custom"/>
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="2" Margin="2,0,2,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Model" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="AiModelInput" Grid.Column="1" Text="gpt-5.5" Margin="3"/>
                        <TextBlock Grid.Column="2" Text="API key (Custom: tùy chọn)" VerticalAlignment="Center" Margin="5"/>
                        <PasswordBox x:Name="AiKeyInput" Grid.Column="3" Margin="3"/>
                        <WrapPanel Grid.Column="4" HorizontalAlignment="Right">
                            <Button x:Name="AiRunButton" Content="Tạo kịch bản bằng AI" Click="AiRunClick"/>
                            <Button x:Name="AiCancelButton" Content="Hủy" Click="AiCancelClick" IsEnabled="False"/>
                            <Button Content="Lưu 4 file vào dự án" Click="AiSaveClick"/>
                            <Button Content="Đưa voice vào dự án" Click="AiImportVoiceClick"/>
                        </WrapPanel>
                    </Grid>
                    <Border x:Name="AiCustomOptions" Grid.Row="3" Visibility="Collapsed"
                            Margin="4,0,4,8" Padding="7" BorderBrush="#BBBBBB" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Base URL" VerticalAlignment="Center" Margin="5"/>
                            <TextBox x:Name="AiCustomBaseUrl" Grid.Column="1" Margin="3"
                                     Text="http://127.0.0.1:8080/v1" ToolTip="Ví dụ http://127.0.0.1:8080/v1 hoặc https://proxy.example.com/v1"/>
                            <TextBlock Grid.Column="2" Text="Endpoint" VerticalAlignment="Center" Margin="5"/>
                            <ComboBox x:Name="AiCustomEndpointInput" Grid.Column="3" SelectedIndex="0" Margin="3">
                                <ComboBoxItem Content="/v1/chat/completions" Tag="ChatCompletions"/>
                                <ComboBoxItem Content="/v1/responses" Tag="Responses"/>
                            </ComboBox>
                            <Button Grid.Column="4" x:Name="AiTestButton"
                                    Content="Test Connection" Click="AiTestConnectionClick"/>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="4" Margin="4">
                        <TabItem Header="01 · Lời thuyết minh">
                            <TextBox x:Name="AiScriptEditor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
                        </TabItem>
                        <TabItem Header="02 · Voice tách đoạn">
                            <TextBox x:Name="AiVoiceEditor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
                        </TabItem>
                        <TabItem Header="03 · Kế hoạch bản đồ">
                            <TextBox x:Name="AiMapEditor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                        </TabItem>
                        <TabItem Header="05 · Gói YouTube">
                            <TextBox x:Name="AiPackageEditor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                        </TabItem>
                        <TabItem Header="Historical World 3D">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="H2 Historical World V6.4 — Kịch bản → Scene Plan → Video" FontSize="19" FontWeight="Bold" Margin="4,4,4,12"/>
                    <DockPanel Grid.Row="1" Margin="4"><TextBlock DockPanel.Dock="Left" Width="120" Text="Engine folder"/><TextBox x:Name="WorldEnginePath" Text="engines/h2-historical-world"/></DockPanel>
                    <DockPanel Grid.Row="2" Margin="4"><TextBlock DockPanel.Dock="Left" Width="120" Text="Scene JSON"/><TextBox x:Name="WorldScenePath" Text="build/v6_2_scene.json"/></DockPanel>
                    <DockPanel Grid.Row="3" Margin="4"><TextBlock DockPanel.Dock="Left" Width="120" Text="Blender.exe"/><TextBox x:Name="WorldBlenderPath" Text="C:\Program Files\Blender Foundation\Blender 5.2\blender.exe"/></DockPanel>
                    <DockPanel Grid.Row="4" Margin="4"><TextBlock DockPanel.Dock="Left" Width="120" Text="Output folder"/><TextBox x:Name="WorldOutputPath" Text="build/v6_4_studio"/></DockPanel>
                    <WrapPanel Grid.Row="5" Margin="4">
                        <TextBlock Text="Frames" VerticalAlignment="Center"/><TextBox x:Name="WorldFrames" Width="65" Text="48" Margin="8,0,18,0"/>
                        <TextBlock Text="FPS" VerticalAlignment="Center"/><TextBox x:Name="WorldFps" Width="55" Text="24" Margin="8,0,18,0"/>
                        <Button x:Name="WorldRenderButton" Content="Render MP4" Click="WorldRenderClick" Padding="12,6"/>
                        <Button Content="Hủy" Click="WorldCancelClick" Padding="12,6" Margin="8,0"/>
                        <Button Content="Mở MP4" Click="WorldOpenMp4Click" Padding="12,6"/>
                        <TextBlock x:Name="WorldStatus" Text="Sẵn sàng" Margin="12,5"/>
                    </WrapPanel>
                    <StackPanel Grid.Row="6" Margin="4">
                        <TextBlock Text="Kịch bản lịch sử (nhập mô tả hoặc dán bản nháp Scene Plan JSON)" FontWeight="SemiBold"/>
                        <Button Content="Tạo Scene Plan nháp (cần duyệt)" Click="WorldPlanClick" HorizontalAlignment="Left" Margin="0,5" Padding="12,5"/>
                    </StackPanel>
                    <TextBox Grid.Row="7" x:Name="WorldScriptText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="4"/>
                </Grid>
            </TabItem>
        </TabControl>
                    <StackPanel Grid.Row="5" Margin="4,8">
                        <TextBlock x:Name="AiStatus" TextWrapping="Wrap" Text="Chọn một dự án ở tab Dự án, nhập API key, rồi bấm Tạo kịch bản bằng AI."/>
                        <TextBlock Margin="0,5,0,0" Foreground="#A84B22" TextWrapping="Wrap" Text="Ghi chú: AI hiện không có tính năng tra cứu hoặc xác minh nguồn tự động. Số liệu, nguồn, năm và tọa độ cần người dùng kiểm chứng. API key không được lưu vào settings.json."/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Kịch bản và giọng đọc">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Mở tệp lời đọc TXT" Click="LoadScriptClick"/>
                        <Button Content="Lưu tệp lời đọc TXT" Click="SaveScriptClick"/>
                        <TextBlock Text="Dùng dấu | để ngăn cách các đoạn lời đọc. Đặt tên MP3 theo thứ tự: 1.mp3, 2.mp3, ..." VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" Name="ScriptEditor" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <Grid Grid.Row="2" Margin="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Thư mục MP3" VerticalAlignment="Center"/>
                        <TextBox Name="VoiceFolder" Grid.Column="1"/>
                        <Button Grid.Column="2" Content="Chọn thư mục" Click="BrowseVoiceClick"/>
                    </Grid>
                    <StackPanel Grid.Row="3">
                        <WrapPanel Margin="0,4,0,5" VerticalAlignment="Center">
                            <TextBlock Text="TTS · Giọng đọc" FontWeight="SemiBold" Margin="5" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TtsVoiceCombo" IsEditable="True" IsTextSearchEnabled="False"
                                      Width="225" Margin="5" ToolTip="Nhập Voice ID hoặc chọn giọng đã lưu"/>
                            <Button Content="Lưu giọng" Click="TtsSaveVoiceClick"/>
                            <Button Content="Xóa giọng" Click="TtsRemoveVoiceClick"/>
                            <Button x:Name="TtsGenerateButton" Content="Tạo MP3" Click="TtsGenerateClick"/>
                            <Button x:Name="TtsCancelButton" Content="Hủy TTS" Click="TtsCancelClick" IsEnabled="False"/>
                            <Button Content="Mở thư mục MP3" Click="TtsOpenFolderClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="TtsStatusText" Margin="6,0,0,6" TextWrapping="Wrap"
                                   Text="Chưa cấu hình API TTS. Bạn có thể lưu Voice ID và chuẩn bị lời đọc; chưa thể tạo MP3 cho đến khi tích hợp API."/>
                        <WrapPanel>
                            <Button Content="Kiểm tra số tệp MP3" Click="ValidateVoiceClick"/>
                        <Button Content="Tạo timeline lời đọc" Click="PrepareVoiceClick"/>
                        <Button Content="Tạo cảnh nháp" Click="DraftShotsClick"/>
                        <Button Content="Mở thư mục timeline" Click="OpenTimelineClick"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Biên tập cảnh bản đồ">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2">
                        <Button Content="Tải lại shots.json" Click="LoadShotsClick"/>
                        <Button Content="Kiểm tra và lưu toàn bộ cảnh" Click="SaveShotsClick"/>
                        <Button x:Name="AiBuildTerrainButton" Content="AI tạo toàn bộ cảnh Terrain 3D"
                                Click="AiBuildTerrainClick" ToolTip="Dựa trên 03-HINH và template Terrain thực, giữ nguyên thời gian và lời đọc"/>
                        <Button x:Name="AiCancelTerrainButton" Content="Hủy AI Terrain"
                                Click="AiCancelTerrainClick" IsEnabled="False"/>
                        <TextBlock Text="Chọn cảnh, chỉnh tham số JSON rồi áp dụng. Các trường bổ sung được giữ nguyên." VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid Name="ShotsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ShotsSelectionChanged"
                              Margin="4" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                            <DataGridTextColumn Header="Bắt đầu" Binding="{Binding Start}" Width="65"/>
                            <DataGridTextColumn Header="Kết thúc" Binding="{Binding End}" Width="65"/>
                            <DataGridTextColumn Header="Mẫu cảnh" Binding="{Binding Template}" Width="80"/>
                            <DataGridTextColumn Header="Lời thuyết minh" Binding="{Binding Line}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Thuộc tính cảnh bản đồ" FontSize="16" FontWeight="Bold" Margin="4"/>
                            <WrapPanel>
                                <TextBlock Text="Khung nhìn" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Name="MapViewInput" Width="130" ToolTip="Ví dụ mã khung nhìn: bac-bo"/>
                                <TextBlock Text="Template" VerticalAlignment="Center" Margin="5"/>
                                <TextBox x:Name="ShotTemplateInput" Width="85" ToolTip="bando: map; terrain: tw hoặc map2d" />
                                <TextBlock Text="Năm" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Name="MapYearInput" Width="75"/>
                                <TextBlock Text="Địa danh" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Name="MapPlaceInput" Width="115" ToolTip="Ví dụ mã địa danh: hoa-lu"/>
                                <Button Content="Áp dụng thuộc tính bản đồ" Click="ApplyMapFieldsClick"/>
                            </WrapPanel>
                            <TextBlock Text="Tham số cảnh nâng cao (JSON)" FontWeight="SemiBold" Margin="4,5,4,0"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Name="ArgsEditor" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <WrapPanel Grid.Row="2">
                            <Button Content="Áp dụng thay đổi cảnh" Click="ApplyShotClick"/>
                            <Button Content="Chỉnh worlds JSON (Terrain)" Click="EditWorldsClick"/>
                            <Button Content="Tải dữ liệu độ cao DEM" Click="DownloadTerrainClick"/>
                        </WrapPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <TextBlock x:Name="AiTerrainStatus" Margin="5,2" TextWrapping="Wrap"
                            Text="AI Terrain: Chọn dự án terrain có shots.json và 03-HINH để tạo toàn bộ cảnh."/>
                        <TextBlock Margin="5" TextWrapping="Wrap" Text="Bản đồ 2D: view/year/labels và tpl=map. Terrain: tpl=tw hoặc map2d, tham số cam/camFrom/world/do và worlds ở story/shots.json. Không tự động chuyển đổi cảnh giữa các pack."/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Xem trước bản đồ">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Bắt đầu xem bản đồ" Click="StartLiveClick"/>
                        <Button Content="Tải lại dữ liệu cảnh" Click="RefreshLiveClick"/>
                        <Button Content="Dừng xem bản đồ" Click="StopLiveClick"/>
                        <TextBlock Name="LiveStatus" VerticalAlignment="Center" Margin="10,0,0,0" Text="Chưa chạy"/>
                    </StackPanel>
                    <wv2:WebView2 Name="MapBrowser" Grid.Row="1" Margin="4"/>
                    <DockPanel Grid.Row="2">
                        <Button Content="Đến thời điểm" Click="SeekLiveClick" DockPanel.Dock="Right"/>
                        <Slider Name="MapTime" Minimum="0" Maximum="60" Value="0" Margin="12"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Dựng và xem video">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="Kiểm tra cảnh" Click="CheckRenderClick"/>
                            <Button Content="Bảng ảnh tổng hợp" Click="SheetRenderClick"/>
                            <Button Content="Xem thử 30 giây đầu" Click="PreviewRenderClick"/>
                            <Button Content="Dựng toàn bộ video" Click="FullRenderClick"/>
                            <Button Content="Ghép âm thanh" Click="MixRenderClick"/>
                            <Button Content="Xuất ảnh bìa" Click="ThumbnailRenderClick"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Khung nhìn ảnh bìa" Margin="6" VerticalAlignment="Center"/>
                            <TextBox Name="ThumbViewInput" Width="115" Text="viet-nam"/>
                            <TextBlock Text="Dòng 1" Margin="6" VerticalAlignment="Center"/>
                            <TextBox Name="ThumbLineOne" Width="145" Text="LỊCH SỬ"/>
                            <TextBlock Text="Dòng 2" Margin="6" VerticalAlignment="Center"/>
                            <TextBox Name="ThumbLineTwo" Width="145" Text="BẢN ĐỒ"/>
                            <Button Content="Tạo cảnh ảnh bìa" Click="CreateThumbSceneClick"/>
                        </WrapPanel>
                    </StackPanel>
                    <MediaElement Name="VideoPlayer" Grid.Row="1" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                  MediaFailed="VideoPlayerFailed" Margin="6" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Phát" Click="PlayVideoClick"/>
                        <Button Content="Tạm dừng" Click="PauseVideoClick"/>
                        <Button Content="Mở thư mục kết quả" Click="OpenOutputClick"/>
                        <Button Content="Sao chép sang thư mục xuất" Click="PublishExportClick"/>
                        <Button Content="Mở thư mục xuất" Click="OpenExportClick"/>
                        <TextBlock Name="RenderStatus" Margin="15,0,0,0" VerticalAlignment="Center" Text="Sẵn sàng"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Cài đặt">
                <StackPanel Margin="16">
                    <TextBlock Text="Engine H2 (studio cạnh EXE)" FontWeight="Bold"/>
                    <WrapPanel Margin="0,4,0,8">
                        <Button Content="Dùng cấu trúc Portable cạnh EXE" Click="UsePortableLayoutClick"/>
                        <Button Content="Nhập engine H2 vào studio" Click="ImportEngineClick"/>
                        <Button Content="Mở thư mục Portable" Click="OpenPortableRootClick"/>
                    </WrapPanel>
                    <TextBlock x:Name="PortableStatus" Margin="6" TextWrapping="Wrap"
                               Text="Thư mục studio cần chứa render.mjs, player.html, tools và packs. Chỉ tạo thư mục không đủ để render."/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Chọn thư mục" Click="BrowseStudioClick"/>
                        <TextBox Name="StudioRootText"/>
                    </DockPanel>
                    <TextBlock Margin="12,12,4,4" FontWeight="Bold" Text="Workspace dự án (không nằm trong thư mục engine)"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Chọn thư mục" Click="BrowseWorkspaceClick"/>
                        <TextBox Name="WorkspaceRootText"/>
                    </DockPanel>
                    <TextBlock Margin="12,12,4,4" FontWeight="Bold" Text="Thư mục xuất video hoàn chỉnh"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Chọn thư mục" Click="BrowseExportsClick"/>
                        <TextBox Name="ExportRootText"/>
                    </DockPanel>
                    <TextBlock Margin="4" Text="Tệp chạy Node.js"/>
                    <TextBox Name="NodeText"/>
                    <TextBlock Margin="4" Text="Tệp chạy Python"/>
                    <TextBox Name="PythonText"/>
                    <TextBlock Margin="4" Text="Tệp chạy FFmpeg"/>
                    <TextBox Name="FfmpegText"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Lưu cài đặt" Click="SaveSettingsClick"/>
                        <Button Content="Kiểm tra môi trường Studio" Click="DoctorClick"/>
                        <Button Content="Quản lý / cài đặt môi trường" Click="OpenEnvironmentClick"/>
                    </StackPanel>
                    <TextBlock Margin="4,18" TextWrapping="Wrap" Text="Bản Portable sử dụng studio/, Projects/ và Exports/ cạnh EXE. Nếu studio chưa có engine, hãy bấm Nhập engine H2 vào studio. Chỉ cài dependencies sau khi import engine thành công. Không cài ứng dụng trong Program Files nếu cần ghi dữ liệu."/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Quản lý môi trường">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Thiết lập môi trường H2 Studio" FontSize="20" FontWeight="Bold" Margin="5"/>
                        <TextBlock Text="Kiểm tra các runtime và thư viện cần thiết. Chỉ cài đặt khi bạn chủ động xác nhận. Việc cài gói hệ thống sử dụng WinGet từ nguồn chính thức; một số thành phần có thể cần quyền quản trị." TextWrapping="Wrap" Margin="5"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,8">
                        <TextBlock Text="Engine cần kiểm tra" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox x:Name="EnvironmentEngineCombo" DisplayMemberPath="DisplayName" Width="230" Margin="4"/>
                        <Button Content="Chọn engine theo dự án" Click="EnvSelectProjectEngineClick"/>
                        <Button x:Name="EnvCheckButton" Content="Kiểm tra tất cả" Click="EnvCheckClick"/>
                        <Button x:Name="EnvInstallSelectedButton" Content="Cài mục đã chọn" Click="EnvInstallSelectedClick"/>
                        <Button x:Name="EnvInstallMissingButton" Content="Cài tất cả thành phần thiếu" Click="EnvInstallMissingClick"/>
                        <Button x:Name="EnvRepairButton" Content="Kiểm tra và sửa chữa" Click="EnvRepairClick"/>
                        <Button Content="Chạy kiểm tra engine (doctor)" Click="DoctorClick"/>
                        <Button x:Name="EnvCancelButton" Content="Hủy cài đặt" Click="EnvCancelClick"/>
                    </WrapPanel>
                    <DataGrid x:Name="EnvironmentGrid" Grid.Row="2" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" Margin="4" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thành phần" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="140"/>
                            <DataGridTextColumn Header="Chi tiết / phiên bản" Binding="{Binding Details}" Width="4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Margin="4,9">
                        <TextBlock x:Name="EnvironmentStatus" Text="Nhấn Kiểm tra tất cả để bắt đầu."/>
                        <ProgressBar x:Name="EnvironmentProgressBar" Minimum="0" Maximum="100" Height="16" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Margin="5" TextWrapping="Wrap" Text="Thứ tự: Node.js/npm → Python → FFmpeg/FFprobe → WebView2 → gói npm → Playwright Chromium → thư viện Python trong .venv. Sau khi cài runtime hệ thống, có thể cần khởi động lại ứng dụng để nhận PATH mới."/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
